; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Graveyard Shift"
run/main_scene="uid://6kyebxi5bbkj"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/image="uid://d2461c2mfp7nk"
config/icon="uid://dlx8vs8ydcha8"

[audio]

buses/default_bus_layout="uid://ciityham4jjfe"

[autoload]

GameManager="*uid://dtbkogjkepxgn"
Utils="*uid://cos4dbspdwf0a"
MusicManager="*uid://c2t0kmebu1eqp"
TutorialManager="*uid://claqn5mk6wn6q"
Dialogic="*uid://ds2q0uclmolvu"
TransitionManager="*uid://bxb5otabu1th8"

[dialogic]

directories/dch_directory={
"ambrosia": "res://cutscene/ambrosia.dch",
"marvy": "res://cutscene/marvy.dch",
"sabrina": "res://cutscene/sabrina.dch"
}
directories/dtl_directory={
"ending": "res://cutscene/ending.dtl",
"level1": "res://cutscene/level1.dtl",
"level2": "res://cutscene/level2.dtl",
"level3": "res://cutscene/level3.dtl",
"opening": "res://cutscene/opening.dtl"
}
layout/style_directory={
"": "res://cutscene/cutscene_style.tres",
"cutscene_style": "res://cutscene/cutscene_style.tres"
}
layout/style_list=["res://cutscene/cutscene_style.tres"]
layout/default_style="res://cutscene/cutscene_style.tres"
glossary/default_case_sensitive=true
variables={}
extensions_folder="res://addons/dialogic_additions"
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.3
animations/join_default_wait=false
animations/leave_default_length=0.2
animations/leave_default_wait=false
animations/cross_fade_default_length=0.1
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"music": {
"audio_bus": "",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}
animations/cross_fade_default="Fade Cross"
animations/leave_default="Fade Out Down"
portraits/default_portrait="res://addons/dialogic/Modules/HighlightPortrait/simple_highlight_portrait.tscn"

[display]

window/size/viewport_width=960
window/size/viewport_height=576
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_height"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg", "res://addons/virtual_joystick_DX/plugin.cfg")

[global_group]

walls=""
food=""
timers=""

